# Server Configuration
PORT=8080
GIN_MODE=debug
FRONTEND_ORIGIN=http://localhost:3000

# Reverse Proxy / Deployment Configuration (Render / Cloudflare)
# Comma-separated CIDRs of trusted proxies. On Render, automatically defaults to 10.0.0.0/8,127.0.0.1/32 when RENDER=true.
TRUSTED_PROXIES=

# Database Configuration (Supabase PostgreSQL)
# If DATABASE_URL is empty in local dev, falls back to local SQLite (cloudprep.db) for instant zero-config testing.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT Authentication Secrets
JWT_ACCESS_SECRET=change-me-in-production-access-secret-key-2026
JWT_REFRESH_SECRET=change-me-in-production-refresh-secret-key-2026

# Dual AI Provider Configuration (Google Gemini + Groq Failover)
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq

GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.8-flash

GROQ_API_KEY=
GROQ_MODEL_ID=openai/gpt-oss-120b

